---
import type { CollectionEntry } from "astro:content";
import * as Table from "$lib/components/ui/table/index.js";
import * as Card from "$lib/components/ui/card/index.js";
import type { MetaProperty } from "./meta";
import MetaTableRowText from "./MetaTableRowText.astro";
import MetaTableRowImage from "./MetaTableRowImage.astro";
import MetaTableRowDate from "./MetaTableRowDate.astro";
import { buildArticleMap } from "$lib/astro-content-utils";

type Props = {
    typeLabel: string;
    kindLabel?: string;
    project: CollectionEntry<"projects">;
    articles: CollectionEntry<"articles">[];
    properties: MetaProperty[];
};
const { typeLabel, kindLabel, project, articles, properties }: Props = Astro.props;

const title = kindLabel ? `${typeLabel} (${kindLabel})` : typeLabel;

const articleMap = buildArticleMap(articles);
---

<span
    class="text-muted-foreground text-sm font-semibold tracking-wider uppercase"
>
    {title}
</span>
<Card.Root class="mt-1 py-0">
    <Table.Root>
        <Table.Body>
            {
                properties
                    .filter((p) => !!p.value)
                    .map((property) => {
                        if (property.type === "text") {
                            return (
                                <MetaTableRowText
                                    {project}
                                    {articleMap}
                                    {property}
                                />
                            );
                        } else if (property.type === "image") {
                            return <MetaTableRowImage {property} />;
                        } else if (property.type === "date") {
                            return <MetaTableRowDate {project} {property} />;
                        }
                    })
            }
        </Table.Body>
    </Table.Root>
</Card.Root>
