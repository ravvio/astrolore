---
import type { CollectionEntry } from "astro:content";
import type { CultureMetadata } from "$lib/schema/codex-article";
import type { MetaProperty } from "./meta";
import type { Translations } from "$lib/i18n";
import MetaCard from "./MetaCard.astro";

type Props = {
  project: CollectionEntry<"projects">;
  articles: CollectionEntry<"articles">[];
  meta: CultureMetadata;
  translations: Translations;
};
const { project, articles, meta, translations }: Props = Astro.props;
const m = translations.meta.culture;
const kindLabel = meta.kind ? translations.meta.kinds.culture[meta.kind] : undefined;

const properties: MetaProperty[] = [
  { type: "text", title: m.parentCulture, value: meta.parentCulture },
];
---

<MetaCard typeLabel={translations.meta.types.culture} {kindLabel} {project} {articles} {properties} />
