---
import { CustomDate } from "$lib/custom-date";
import type { CollectionEntry } from "astro:content";
import * as Table from "$lib/components/ui/table/index.js";
import { cn } from "$lib/utils";
import type { MetaPropertyDate } from "./meta";

type Props = {
    project: CollectionEntry<"projects">;
    property: MetaPropertyDate;
    class?: string;
};

const { project, property, class: className }: Props = Astro.props;

const calendar = project.data.calendar;
const display =
    typeof property.value === "string"
        ? CustomDate.parse(calendar, property.value).toString()
        : `${CustomDate.parse(calendar, property.value!.start).toString()} – ${CustomDate.parse(calendar, property.value!.end).toString()}`;
---

<Table.Row class={cn("", className)}>
    <Table.Cell class="align-top font-semibold">
        {property.title}
    </Table.Cell>
    <Table.Cell class="align-top whitespace-normal">
        {display}
    </Table.Cell>
</Table.Row>
