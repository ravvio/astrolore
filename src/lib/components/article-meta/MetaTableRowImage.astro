---
import * as Table from "$lib/components/ui/table/index.js";
import { cn } from "$lib/utils";
import type { MetaPropertyImage } from "./meta";
import { Image } from "astro:assets";

type Props = {
  property: MetaPropertyImage;
  class?: string;
};

const { property, class: className }: Props = Astro.props;
---

<Table.Row class={cn("flex flex-col items-center", className)}>
  {property.showTitle && <span class="font-semibold">{property.title}</span>}
  {
    typeof property.value != "string" ? (
      <Image src={property.value!} alt={property.title} />
    ) : (
      <img src={property.value!} alt={property.title} />
    )
  }
</Table.Row>
