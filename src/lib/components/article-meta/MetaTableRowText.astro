---
import { isLink, stripLink } from "$lib/content-utils";
import { CustomDate } from "$lib/custom-date";
import type { CollectionEntry } from "astro:content";
import * as Table from "$lib/components/ui/table/index.js";
import { cn } from "$lib/utils";
import type { MetaPropertyText } from "./meta";

type Props = {
    project: CollectionEntry<"projects">;
    articleMap: Map<string, CollectionEntry<"articles">>;
    property: MetaPropertyText;
    class?: string;
};

const { project, articleMap, property, class: className }: Props = Astro.props;

const values =
    typeof property.value === "string" ? [property.value!] : property.value!;
---

<Table.Row class={cn("", className)}>
    <Table.Cell class="align-top font-semibold">
        {property.title}
    </Table.Cell>
    <Table.Cell class="align-top whitespace-normal">
        {
            values
                .map((value) => {
                    if (isLink(value)) {
                        const slug = stripLink(value);
                        const article = articleMap.get(`${project.id}/${slug}`);
                        return (
                            <a
                                href={article ? `/${article.id}` : "#"}
                                class="text-primary hover:text-primary/60 font-semibold underline underline-offset-4"
                            >
                                {article ? article.data.title : slug}
                            </a>
                        );
                    } else if (property.isDate) {
                        return CustomDate.parse(
                            project.data.calendar,
                            value,
                        ).toString();
                    } else {
                        return value;
                    }
                })
                .reduce((res, item) => (
                    <>
                        {res}, {item}
                    </>
                ))
        }
    </Table.Cell>
</Table.Row>
