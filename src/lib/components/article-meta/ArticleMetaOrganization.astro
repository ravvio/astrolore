---
import type { CollectionEntry } from "astro:content";
import type { MetaProperty } from "./meta";
import type { OrganizationMetadata } from "$lib/schema/codex-article";
import type { Translations } from "$lib/i18n";
import MetaCard from "./MetaCard.astro";

type Props = {
    project: CollectionEntry<"projects">;
    articles: CollectionEntry<"articles">[];
    meta: OrganizationMetadata;
    translations: Translations;
};
const { project, articles, meta, translations }: Props = Astro.props;
const m = translations.meta.organization;
const kindLabel = meta.kind
    ? translations.meta.kinds.organization[meta.kind]
    : undefined;

const properties: MetaProperty[] = [
    { type: "image", title: m.symbol, value: meta.symbol },
    { type: "text", title: m.leaders, value: meta.leaders },
    { type: "text", title: m.formerLeaders, value: meta.formerLeaders },
    { type: "text", title: m.foundedBy, value: meta.founders },
    { type: "date", title: m.founding, value: meta.founding },
    { type: "date", title: m.termination, value: meta.termination },
];

if (meta.kind === "country") {
    properties.push(
        { type: "text", title: m.capital, value: meta.capital },
        { type: "text", title: m.cultures, value: meta.cultures },
        { type: "text", title: m.languages, value: meta.languages },
    );
}
---

<MetaCard
    typeLabel={translations.meta.types.organization}
    {kindLabel}
    {project}
    {articles}
    {properties}
/>
