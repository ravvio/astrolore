---
import type { CollectionEntry } from "astro:content";
import type { MetaProperty } from "./meta";
import type { CharacterMetadata } from "$lib/schema/codex-article";
import type { Translations } from "$lib/i18n";
import MetaCard from "./MetaCard.astro";

type Props = {
  project: CollectionEntry<"projects">;
  articles: CollectionEntry<"articles">[];
  meta: CharacterMetadata;
  translations: Translations;
};
const { project, articles, meta, translations }: Props = Astro.props;
const m = translations.meta.character;
const kindLabel = meta.kind ? translations.meta.kinds.character[meta.kind] : undefined;

const properties: MetaProperty[] = [
  { type: "image", title: m.portrait,            value: meta.image },
  { type: "text",  title: m.creature,            value: meta.creature },
  { type: "text",  title: m.titles,              value: meta.titles },
  { type: "text",  title: m.epithets,            value: meta.epithets },
  { type: "text",  title: m.family,              value: meta.family },
  { type: "text",  title: m.cultures,            value: meta.cultures },
  { type: "text",  title: m.organizations,       value: meta.organizations },
  { type: "text",  title: m.formerOrganizations, value: meta.organizationsFormer },
  { type: "date",  title: m.birth,               value: meta.birth },
  { type: "text",  title: m.bornIn,              value: meta.bornIn },
  { type: "date",  title: m.death,               value: meta.death },
  { type: "text",  title: m.diedIn,              value: meta.diedIn },
];
---

<MetaCard typeLabel={translations.meta.types.character} {kindLabel} {project} {articles} {properties} />
