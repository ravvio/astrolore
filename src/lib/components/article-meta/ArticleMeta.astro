---
import type { CollectionEntry } from "astro:content";
import ArticleMetaCharacter from "./ArticleMetaCharacter.astro";
import ArticleMetaCreature from "./ArticleMetaCreature.astro";
import ArticleMetaLocation from "./ArticleMetaLocation.astro";
import ArticleMetaOrganization from "./ArticleMetaOrganization.astro";
import ArticleMetaHistoric from "./ArticleMetaHistoric.astro";
import ArticleMetaFamily from "./ArticleMetaFamily.astro";
import ArticleMetaTitle from "./ArticleMetaTitle.astro";
import ArticleMetaLanguage from "./ArticleMetaLanguage.astro";
import ArticleMetaCulture from "./ArticleMetaCulture.astro";
import { getTranslations } from "$lib/i18n";

type Props = {
  project: CollectionEntry<"projects">;
  articles: CollectionEntry<"articles">[];
  article: CollectionEntry<"articles">;
};
const { project, articles, article }: Props = Astro.props;

const translations = getTranslations(project.data.language);
---

{
  article.data.meta?.type === "character" && (
    <ArticleMetaCharacter {project} {articles} {translations} meta={article.data.meta} />
  )
}
{
  article.data.meta?.type === "creature" && (
    <ArticleMetaCreature {project} {articles} {translations} meta={article.data.meta} />
  )
}
{
  article.data.meta?.type === "location" && (
    <ArticleMetaLocation {project} {articles} {translations} meta={article.data.meta} />
  )
}
{
  article.data.meta?.type === "organization" && (
    <ArticleMetaOrganization {project} {articles} {translations} meta={article.data.meta} />
  )
}
{
  article.data.meta?.type === "historic" && (
    <ArticleMetaHistoric {project} {articles} {translations} meta={article.data.meta} />
  )
}
{
  article.data.meta?.type === "family" && (
    <ArticleMetaFamily {project} {articles} {translations} meta={article.data.meta} />
  )
}
{
  article.data.meta?.type === "title" && (
    <ArticleMetaTitle {project} {articles} {translations} meta={article.data.meta} />
  )
}
{
  article.data.meta?.type === "language" && (
    <ArticleMetaLanguage {project} {articles} {translations} meta={article.data.meta} />
  )
}
{
  article.data.meta?.type === "culture" && (
    <ArticleMetaCulture {project} {articles} {translations} meta={article.data.meta} />
  )
}
