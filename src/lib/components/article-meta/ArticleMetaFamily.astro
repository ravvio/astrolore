---
import type { CollectionEntry } from "astro:content";
import type { MetaProperty } from "./meta";
import type { FamilyMetadata } from "$lib/schema/codex-article";
import type { Translations } from "$lib/i18n";
import MetaCard from "./MetaCard.astro";

type Props = {
    project: CollectionEntry<"projects">;
    articles: CollectionEntry<"articles">[];
    meta: FamilyMetadata;
    translations: Translations;
};
const { project, articles, meta, translations }: Props = Astro.props;
const m = translations.meta.family;

const properties: MetaProperty[] = [
    { type: "image", title: m.emblem, value: meta.emblem },
    { type: "text", title: m.head, value: meta.head },
];
---

<MetaCard
    typeLabel={translations.meta.types.family}
    kindLabel={undefined}
    {project}
    {articles}
    {properties}
/>
