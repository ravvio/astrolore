---
import type { CollectionEntry } from "astro:content";
import type { MetaProperty } from "./meta";
import type { HistoricMetadata } from "$lib/schema/codex-article";
import type { Translations } from "$lib/i18n";
import MetaCard from "./MetaCard.astro";

type Props = {
    project: CollectionEntry<"projects">;
    articles: CollectionEntry<"articles">[];
    meta: HistoricMetadata;
    translations: Translations;
};
const { project, articles, meta, translations }: Props = Astro.props;
const m = translations.meta.historic;
const kindLabel = meta.kind
    ? translations.meta.kinds.historic[meta.kind]
    : undefined;

const properties: MetaProperty[] = [
    { type: "image", title: m.image, value: meta.image },
    { type: "date", title: m.date, value: meta.date },
];
---

<MetaCard
    typeLabel={translations.meta.types.historic}
    {kindLabel}
    {project}
    {articles}
    {properties}
/>
