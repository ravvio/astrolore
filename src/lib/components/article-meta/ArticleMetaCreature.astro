---
import type { CollectionEntry } from "astro:content";
import type { MetaProperty } from "./meta";
import type { CreatureMetadata } from "$lib/schema/codex-article";
import type { Translations } from "$lib/i18n";
import MetaCard from "./MetaCard.astro";

type Props = {
    project: CollectionEntry<"projects">;
    articles: CollectionEntry<"articles">[];
    meta: CreatureMetadata;
    translations: Translations;
};
const { project, articles, meta, translations }: Props = Astro.props;
const m = translations.meta.creature;
const kindLabel = meta.kind
    ? translations.meta.kinds.creature[meta.kind]
    : undefined;

const properties: MetaProperty[] = [
    { type: "image", title: m.image, value: meta.image },
    { type: "text", title: m.parentCreature, value: meta.parentCreature },
    { type: "text", title: m.foundIn, value: meta.locations },
];
---

<MetaCard
    typeLabel={translations.meta.types.creature}
    {kindLabel}
    {project}
    {articles}
    {properties}
/>
