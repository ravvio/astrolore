---
import type { CollectionEntry } from "astro:content";
import type { MetaProperty } from "./meta";
import type { LocationMetadata } from "$lib/schema/codex-article";
import type { Translations } from "$lib/i18n";
import MetaCard from "./MetaCard.astro";

type Props = {
  project: CollectionEntry<"projects">;
  articles: CollectionEntry<"articles">[];
  meta: LocationMetadata;
  translations: Translations;
};
const { project, articles, meta, translations }: Props = Astro.props;
const m = translations.meta.location;
const kindLabel = meta.kind ? translations.meta.kinds.location[meta.kind] : undefined;

const properties: MetaProperty[] = [
  { type: "image", title: m.image,         value: meta.image },
  { type: "text",  title: m.parentLocation, value: meta.parentLocation },
];

if (meta.kind === "settlement") {
    properties.push(
        { type: "text",  title: m.foundedBy,      value: meta.founders },
        { type: "date",  title: m.founding,      value: meta.founding },
        { type: "date",  title: m.destruction,      value: meta.destruction },
    );
}

---

<MetaCard typeLabel={translations.meta.types.location} {kindLabel} {project} {articles} {properties} />
