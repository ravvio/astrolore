---
import { buildFamilyChartData } from "../family-tree/family-chart-data";
import FamilyTree from "../family-tree/FamilyTree.svelte";

type Props = {
    slug: string;
};
const { slug } = Astro.props;

const projectId = Astro.url.pathname.split("/")[1];

const persons = await buildFamilyChartData(projectId, slug);
if (persons.length === 0) return;
---

<div class="mb-8 w-full [&:not(:first-child)]:mt-8">
    <FamilyTree {persons} client:idle />
</div>
