---
import ArticleBlockquote from "./ArticleBlockquote.astro";
import DocumentH2 from "./DocumentH2.astro";
import DocumentH3 from "./DocumentH3.astro";
import DocumentH4 from "./DocumentH4.astro";
import ArticleLink from "./ArticleLink.astro";
import ArticleList from "./ArticleList.astro";
import ArticleInlineCode from "./ArticleInlineCode.astro";
import ArticleTable from "./ArticleTable.astro";
import ArticleTableHeader from "./ArticleTableHeader.astro";
import ArticleTableBody from "./ArticleTableBody.astro";
import ArticleTableHead from "./ArticleTableHead.astro";
import ArticleTableRow from "./ArticleTableRow.astro";
import ArticleTableFooter from "./ArticleTableFooter.astro";
import ArticleTableCell from "./ArticleTableCell.astro";
import ArticleImage from "./ArticleImage.astro";
import DocumentParagraph from "./DocumentParagraph.astro";
const { Content, components } = Astro.props;
---

<Content
    components={{
        blockquote: ArticleBlockquote,
        h1: DocumentH2,
        h2: DocumentH3,
        h3: DocumentH4,
        a: ArticleLink,
        ul: ArticleList,
        p: DocumentParagraph,
        code: ArticleInlineCode,
        table: ArticleTable,
        thead: ArticleTableHeader,
        tbody: ArticleTableBody,
        tfoot: ArticleTableFooter,
        th: ArticleTableHead,
        tr: ArticleTableRow,
        td: ArticleTableCell,
        img: ArticleImage,
        ...components,
    }}
/>
