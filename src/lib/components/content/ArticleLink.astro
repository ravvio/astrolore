---
import { ExternalLinkIcon } from "@lucide/svelte";
import ArticleInternalLink from "./ArticleInternalLink.astro";
import { isURL } from "$lib/content-utils";
import { Badge } from "$lib/components/ui/badge/index.js";

type Props = {
    href: string;
};
const { href } = Astro.props;
---

{
    isURL(href) ? (
        <Badge variant="outline" class="text-sm" href={href} target="_blank">
            <ExternalLinkIcon />
            <slot />
        </Badge>
    ) : (
        <ArticleInternalLink slug={decodeURIComponent(href)}>
            <slot />
        </ArticleInternalLink>
    )
}
