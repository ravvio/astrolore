---
import BinderStatblock from "../binder-statblock.svelte";
import { getEntry } from "astro:content";
import { getTranslations } from "$lib/i18n";

type Props = {
    slug: string;
};
const projectId = Astro.url.pathname.split("/")[1];
const { slug } = Astro.props;

const [project, statblock] = await Promise.all([
    getEntry("projects", projectId),
    getEntry("statblocks", `${projectId}/statblocks/${slug}`),
]);
const translations = getTranslations(project?.data.language);
---

{
    statblock && (
        <div class="mb-8 w-full [&:not(:first-child)]:mt-8">
            <BinderStatblock
                data={statblock.data}
                translations={translations}
                client:idle
            />
        </div>
    )
}
