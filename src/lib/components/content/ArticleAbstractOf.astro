---
import { getAbstract } from "$lib/astro-content-utils";
import ArticleParagraph from "./ArticleParagraph.astro";
import ArticleGoto from "./ArticleGoto.astro";
import { getEntry } from "astro:content";

type Props = {
    slug: string;
};

const projectId = Astro.url.pathname.split("/").at(1);
if (!projectId)
    throw new Error(
        `ArticleAbstractOf: no project segment in pathname "${Astro.url.pathname}"`,
    );
const { slug } = Astro.props;

const id = `${projectId}/articles/${slug}`;
const article = await getEntry("articles", id);
const abstract = await getAbstract(article);
---

{abstract && <ArticleGoto slug={slug} />}
<ArticleParagraph>
    {abstract ?? ""}
</ArticleParagraph>
