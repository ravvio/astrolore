---
import { Button } from "$lib/components/ui/button/index.js";
import ArticleHoverCard from "$lib/components/article-hover-card.svelte";
import { getEntry } from "astro:content";
import { getAbstract } from "$lib/astro-content-utils";
import { CornerDownRightIcon } from "@lucide/svelte";

type Props = {
  slug: string;
};
const projectId = Astro.url.pathname.split("/")[1];
const { slug } = Astro.props;
const id = `${projectId}/articles/${slug}`;

const article = await getEntry("articles", id);
const abstract = await getAbstract(article);
---

<ArticleHoverCard {article} {abstract} client:only>
  <Button variant="link" href={`/${id}`}>
    <CornerDownRightIcon />
    {article ? article.data.title : slug}
  </Button>
</ArticleHoverCard>
