---
import MapImage from "$lib/components/map-image/map-image.svelte";
import { cn } from "$lib/utils";
import { getEntry } from "astro:content";
import { getImageSrc } from "$lib/content-utils";

type Props = {
    class: string;
    slug: string;
};
const { class: className, slug } = Astro.props;
const projectId = Astro.url.pathname.split("/")[1];

const mapId = `${projectId}/maps/${slug}`;
const map = await getEntry("maps", mapId);
---

{
    map?.data.image && (
        <div
            class={cn(
                "bg-background z-10 float-right my-2 ml-2 flex min-w-full flex-col space-y-1 rounded-md p-2 lg:max-w-3/5 lg:min-w-3/5",
                className,
            )}
        >
            <MapImage
                projectId={projectId}
                id={slug}
                class="rounded-md"
                src={getImageSrc(map.data.image)}
                markers={JSON.stringify(map.data.markers)}
            />
            {map.data.caption != "" && (
                <span class="text-muted-foreground text-sm italic">
                    {map.data.caption}
                </span>
            )}
        </div>
    )
}
