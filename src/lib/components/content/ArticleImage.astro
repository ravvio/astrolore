---
import { cn } from "$lib/utils";
import { Image } from "astro:assets";

type Props = {
  src: string | ImageMetadata;
  alt: string;
};
const { src, alt }: Props = Astro.props;

const [label, ...tags] = alt.split("#");

const tagsMap: Map<string, string> = new Map([["bw", "dark:bw"]]);
const imgClass = tags
  .map((t) => tagsMap.get(t))
  .filter((t) => !!t)
  .join(" ");
---

<div
  class={cn(
    "flex flex-col rounded-md min-w-full lg:min-w-0 float-right max-w-2/5 p-2 ml-2 space-y-1 bg-background z-10",
  )}
>
  {
    typeof src === "string" ? (
    <img class={cn("rounded-lg", imgClass)} {src} alt={label} />
    ) : (
    <Image class={cn("rounded-lg", imgClass)} {src} alt={label} />
    )
  }
  {
    alt != "" && (
      <span class="text-muted-foreground text-sm italic"> {label} </span>
    )
  }
</div>
