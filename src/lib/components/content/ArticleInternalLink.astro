---
import { getAbstract, getArticleFromSlug } from "$lib/astro-content-utils";
import ArticleHoverCard from "$lib/components/article-hover-card.svelte";
import { Badge } from "$lib/components/ui/badge/index.js";

type Props = {
    slug: string;
};
const { slug } = Astro.props;
const projectId = Astro.url.pathname.split("/")[1];
const article = await getArticleFromSlug(projectId, slug);
const abstract = await getAbstract(article);
---

<ArticleHoverCard {article} {abstract} client:only>
    <Badge
        variant="outline"
        class="text-sm"
        href={article ? `/${article.id}` : undefined}
    >
        <slot />
    </Badge>
</ArticleHoverCard>
