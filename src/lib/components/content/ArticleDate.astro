---
import { CustomDate } from "$lib/custom-date";
import { getEntry } from "astro:content";

async function getDate(projectId: string, dateString: string) {
    const project = await getEntry("projects", projectId);
    return CustomDate.parse(project?.data.calendar, dateString);
}

type Props = {
    value: string;
};
const { value }: Props = Astro.props;

const projectId = Astro.url.pathname.split("/")[1];
const date = await getDate(projectId, value);
---

<span class="italic">
    {date.toString()}
</span>
