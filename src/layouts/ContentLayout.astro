---
import Layout from "./Layout.astro";
import { type CollectionEntry, type Crumb } from "astro:content";

type Props = {
  title: string;
  crumbs: Crumb[];
  project?: CollectionEntry<"projects">;
  needsLeaflet?: boolean;
};
const { title, crumbs, project, needsLeaflet }: Props = Astro.props;
---

<Layout {title} {crumbs} {project} {needsLeaflet}>
  <slot name="heading" />

  <article class="text-foreground-text mt-8">
    <slot />
  </article>
</Layout>
