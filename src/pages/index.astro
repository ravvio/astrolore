---
import Layout from "../layouts/Layout.astro";
import { type Crumb } from "$lib/content-utils";
import { getCollection } from "astro:content";
import { getTranslations } from "$lib/i18n";
import * as Item from "$lib/components/ui/item/index.js";
import * as Empty from "$lib/components/ui/empty/index.js";
import PageTitle from "$lib/components/PageTitle.astro";
import { CircleSlashIcon } from "@lucide/svelte";

const translations = getTranslations("en");
const projects = await getCollection("projects");

const crumbs: Crumb[] = [
    {
        label: "Lore",
        href: "/",
    },
];
---

<Layout title="Lore" crumbs={crumbs}>
    {
        projects.length > 0 ? (
            <div>
                <PageTitle>{translations.common.projects}</PageTitle>
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {projects.map((project) => (
                        <a href={`/${project.id}`} class="group/card block">
                            <Item.Root variant="outline" class="">
                                <Item.Header>
                                    <Item.Title>
                                        {project.data.title}
                                    </Item.Title>
                                </Item.Header>
                                <Item.Content class="text-muted-foreground line-clamp-3">
                                    <Item.Description>
                                        {project.data.description}
                                    </Item.Description>
                                </Item.Content>
                            </Item.Root>
                        </a>
                    ))}
                </div>
            </div>
        ) : (
            <Empty.Root>
                <Empty.Header>
                    <Empty.Media variant="icon">
                        <CircleSlashIcon />
                    </Empty.Media>
                    <Empty.Title>{translations.common.categories}</Empty.Title>
                    <Empty.Description>
                        {translations.search.noResults}
                    </Empty.Description>
                </Empty.Header>
            </Empty.Root>
        )
    }
</Layout>
