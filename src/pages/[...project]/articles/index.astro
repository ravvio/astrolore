---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import PaginatedArticlesSearch from "$lib/components/paginated-articles-search.svelte";
import PageTitle from "$lib/components/PageTitle.astro";
import { projectFromId, type Crumb } from "$lib/content-utils";
import { getTranslations } from "$lib/i18n";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    return projects.map((project) => ({
        params: {
            project: project.id,
        },
        props: {
            project: project,
        },
    }));
}

const { project } = Astro.props;

const articles = await getCollection(
    "articles",
    ({ id }) => projectFromId(id) === project.id,
);

const translations = getTranslations(project.data.language);
const crumbs: Crumb[] = [
    {
        label: project.data.title,
        href: `/${project.id}`,
    },
    {
        label: translations.common.articles,
        href: `/${project.id}/articles`,
    },
];
---

<Layout title={`${project.data.title} - Articles`} {crumbs} {project}>
    <PageTitle>{translations.common.articles}</PageTitle>
    <PaginatedArticlesSearch
        {project}
        {articles}
        perPage={30}
        placeholder={translations.search.placeholder}
        client:idle
    />
</Layout>
