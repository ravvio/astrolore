---
import { getCollection } from "astro:content";
import { getTranslations } from "$lib/i18n";
import ContentLayout from "../../../layouts/ContentLayout.astro";
import BinderStatblock from "$lib/components/binder-statblock.svelte";
import { slugFromId, type Crumb } from "$lib/content-utils";
import { getProjectFromId } from "$lib/astro-content-utils";

export async function getStaticPaths() {
    const statblocks = await getCollection("statblocks");

    return Promise.all(
        statblocks.map(async (statblock) => {
            const statblockSlug = slugFromId(statblock.id);
            const project = await getProjectFromId(statblock.id);

            return {
                params: {
                    project: project.id,
                    statblock: statblockSlug,
                },
                props: {
                    project: project,
                    statblock: statblock,
                },
            };
        }),
    );
}

const { project, statblock } = Astro.props;

const translations = getTranslations(project.data.language);
const crumbs: Crumb[] = [
    {
        label: project.data.title,
        href: `/${project.id}`,
    },
    {
        label: translations.common.documents,
        href: `/${project.id}/documents`,
    },
    {
        label: statblock.data.name,
        href: `/${statblock.id}`,
    },
];
---

<ContentLayout
    project={project}
    title={`${project.data.title} - ${statblock.data.name}`}
    {crumbs}
>
    <BinderStatblock
        translations={translations}
        data={statblock.data}
        preferredSystem={project.data.preferredGameSystem}
        showImage
        client:idle
    />
</ContentLayout>
