---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import PaginatedStatblocksSearch from "$lib/components/paginated-statblocks-search.svelte";
import PageTitle from "$lib/components/PageTitle.astro";
import { projectFromId, type Crumb } from "$lib/content-utils";
import { getTranslations } from "$lib/i18n";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    return Promise.all(
        projects.map(async (project) => {
            const statblocks = await getCollection(
                "statblocks",
                ({ id }) => projectFromId(id) === project.id,
            );
            return {
                params: {
                    project: project.id,
                },
                props: {
                    project: project,
                    statblocks: statblocks,
                },
            };
        }),
    );
}

const { project, statblocks } = Astro.props;

const translations = getTranslations(project.data.language);
const crumbs: Crumb[] = [
    {
        label: project.data.title,
        href: `/${project.id}`,
    },
    {
        label: translations.common.statblocks,
        href: `/${project.id}/statblocks`,
    },
];
---

<Layout
    title={`${project.data.title} - ${translations.common.statblocks}`}
    {crumbs}
    {project}
>
    <PageTitle>{translations.common.statblocks}</PageTitle>
    <PaginatedStatblocksSearch
        {statblocks}
        placeholder={translations.search.placeholder}
        client:idle
    />
</Layout>
