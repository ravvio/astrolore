---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import PaginatedDocumentsSearch from "$lib/components/paginated-documents-search.svelte";
import PageTitle from "$lib/components/PageTitle.astro";
import { projectFromId, type Crumb } from "$lib/content-utils";
import { getTranslations } from "$lib/i18n";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    return Promise.all(
        projects.map(async (project) => {
            const documents = await getCollection(
                "documents",
                ({ id }) => projectFromId(id) === project.id,
            );
            return {
                params: {
                    project: project.id,
                },
                props: {
                    project: project,
                    documents: documents,
                },
            };
        }),
    );
}

const { project, documents } = Astro.props;

const translations = getTranslations(project.data.language);
const crumbs: Crumb[] = [
    {
        label: project.data.title,
        href: `/${project.id}`,
    },
    {
        label: translations.common.documents,
        href: `/${project.id}/documents`,
    },
];
---

<Layout
    title={`${project.data.title} - ${translations.common.documents}`}
    {crumbs}
    {project}
>
    <PageTitle>{translations.common.documents}</PageTitle>
    <PaginatedDocumentsSearch
        {documents}
        placeholder={translations.search.placeholder}
        client:idle
    />
</Layout>
