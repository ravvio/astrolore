---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import PaginatedDocumentsSearch from "$lib/components/paginated-documents-search.svelte";
import { projectFromId, type Crumb } from "$lib/content-utils";
import { getTranslations } from "$lib/i18n";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    return projects.map((project) => ({
        params: {
            project: project.id,
        },
        props: {
            project: project,
        },
    }));
}

const { project } = Astro.props;

const documents = await getCollection(
    "documents",
    ({ id }) => projectFromId(id) === project.id,
);

const translations = getTranslations(project.data.language);
const crumbs: Crumb[] = [
    {
        label: project.data.title,
        href: `/${project.id}`,
    },
    {
        label: translations.common.documents,
        href: `/${project.id}/documents`,
    },
];
---

<Layout title={`${project.data.title} - Documents`} {crumbs} {project}>
    <PaginatedDocumentsSearch
        {documents}
        placeholder={translations.common.search}
        client:idle
    />
</Layout>
