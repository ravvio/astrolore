---
import { getCollection } from "astro:content";
import ContentLayout from "../../../layouts/ContentLayout.astro";
import {
    projectFromId,
    slugFromId,
    stripLink,
    isLink,
    type Crumb,
} from "$lib/content-utils";
import { render, getEntry } from "astro:content";
import Document from "$lib/components/content/Document.astro";
import ContentHeading from "$lib/components/ContentHeading.astro";
import { buildArticleMap } from "$lib/astro-content-utils";
import { getTranslations } from "$lib/i18n";

export async function getStaticPaths() {
    const documents = await getCollection("documents");
    const articles = await getCollection("articles");

    const articleMap = buildArticleMap(articles);

    return Promise.all(
        documents.map(async (document) => {
            const projectId = projectFromId(document.id);
            const documentSlug = slugFromId(document.id);

            const project = await getEntry("projects", projectId);
            if (!project) throw `No project with id ${projectId}`;

            const author =
                document.data.author && isLink(document.data.author)
                    ? articleMap.get(
                          `${projectId}/${stripLink(document.data.author)}`,
                      )
                    : null;

            return {
                params: {
                    project: projectId,
                    document: documentSlug,
                },
                props: {
                    project: project,
                    document: document,
                    author: author,
                },
            };
        }),
    );
}

const { project, document, author } = Astro.props;
const { Content } = await render(document);
const slug = slugFromId(document.id);

const translations = getTranslations(project.data.language);
const crumbs: Crumb[] = [
    {
        label: project.data.title,
        href: `/${project.id}`,
    },
    {
        label: translations.common.documents,
        href: `/${project.id}/documents`,
    },
    {
        label: document.data.title,
        href: `/${document.id}`,
    },
];
---

<ContentLayout title={project.data.title} {crumbs} {project}>
    <ContentHeading slot="heading" id={slug}>
        {document.data.title}
        <div slot="data">
            {
                document.data.author && (
                    <span class="text-sm">
                        <span class="text-foreground/80 font-semibold">
                            Author:
                        </span>
                        {author ? (
                            <a
                                href={`/${author.id}`}
                                class="text-primary/80 hover:underline"
                            >
                                {author.data.title}
                            </a>
                        ) : (
                            <span>{document.data.author}</span>
                        )}
                    </span>
                )
            }
        </div>
    </ContentHeading>

    <Document {Content} />
</ContentLayout>
