---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PaginatedTablesSearch from "$lib/components/paginated-tables-search.svelte";
import PageTitle from "$lib/components/PageTitle.astro";
import { projectFromId, type Crumb } from "$lib/content-utils";
import { getTranslations } from "$lib/i18n";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    return projects.map((project) => ({
        params: {
            project: project.id,
        },
        props: {
            project: project,
        },
    }));
}

const { project } = Astro.props;

const tables = await getCollection("tables", (t) => {
    return projectFromId(t.id) == project.id;
});

const translations = getTranslations(project.data.language);
const crumbs: Crumb[] = [
    {
        label: project.data.title,
        href: `/${project.id}`,
    },
    {
        label: translations.common.tables,
        href: `/${project.id}/tables`,
    },
];
---

<Layout
    title={`${project.data.title} - ${translations.common.tables}`}
    {crumbs}
    {project}
>
    <PageTitle>{translations.common.tables}</PageTitle>
    <PaginatedTablesSearch
        {tables}
        placeholder={translations.search.placeholder}
        client:idle
    />
</Layout>
