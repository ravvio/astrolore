---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import PaginatedTimelinesSearch from "$lib/components/paginated-timelines-search.svelte";
import PageTitle from "$lib/components/PageTitle.astro";
import { projectFromId, type Crumb } from "$lib/content-utils";
import { getTranslations } from "$lib/i18n";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    return projects.map((project) => ({
        params: {
            project: project.id,
        },
        props: {
            project: project,
        },
    }));
}

const { project } = Astro.props;

const timelines = await getCollection("timelines", (t) => {
    return projectFromId(t.id) == project.id;
});

const translations = getTranslations(project.data.language);
const crumbs: Crumb[] = [
    {
        label: project.data.title,
        href: `/${project.id}`,
    },
    {
        label: translations.common.timelines,
        href: `/${project.id}/timelines`,
    },
];
---

<Layout title={`${project.data.title} - Timelines`} {crumbs} {project}>
    <PageTitle>{translations.common.timelines}</PageTitle>
    <PaginatedTimelinesSearch
        {timelines}
        placeholder={translations.search.placeholder}
        client:idle
    />
</Layout>
