---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageTitle from "$lib/components/PageTitle.astro";
import ArticlesGraph from "$lib/components/graph/ArticlesGraph.astro";
import { projectFromId, type Crumb } from "$lib/content-utils";
import { getTranslations } from "$lib/i18n";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    return projects.map((project) => ({
        params: {
            project: project.id,
        },
        props: {
            project: project,
        },
    }));
}

const { project } = Astro.props;
const articles = await getCollection(
    "articles",
    ({ id }) => projectFromId(id) === project.id,
);
const categories = await getCollection(
    "categories",
    ({ id }) => projectFromId(id) === project.id,
);

const translations = getTranslations(project.data.language);
const crumbs: Crumb[] = [
    {
        label: project.data.title,
        href: `/${project.id}`,
    },
    {
        label: translations.common.graph,
        href: `/${project.id}/graph`,
    },
];
---

<Layout
    title={`${project.data.title} - ${translations.common.graph}`}
    {crumbs}
    {project}
    fullScreen={true}
>
    <ArticlesGraph {project} {articles} {categories} class="h-full w-full" />
</Layout>
